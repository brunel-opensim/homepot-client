# Production build environment for the dashboard.
#
# The dashboard is served by Apache at https://homepot.cabera.com, which also
# reverse-proxies /api/* to the backend on 127.0.0.1:8000. Keeping
# VITE_API_BASE_URL empty makes the built bundle call the API same-origin
# (/api/v1). Do NOT set it to http://localhost:8000 — the browser would then
# call the *client's* machine and login would fail for every remote user.
#
# Vite precedence for `npm run build` (mode=production):
#   .env.production.local > .env.production (this file) > .env.local > .env
# so this file overrides the localhost default that start-dashboard.sh writes
# into .env.local.
VITE_API_BASE_URL=
VITE_WS_URL=
VITE_API_TIMEOUT=30000
# AI answers run local CPU inference and can take 60-120s+; keep this at least
# as long as Apache's ProxyTimeout for the API vhost (see docs/server-deployment.md).
VITE_AI_QUERY_TIMEOUT=180000
VITE_ENABLE_WEBSOCKET=true
VITE_ENABLE_PUSH_NOTIFICATIONS=true
