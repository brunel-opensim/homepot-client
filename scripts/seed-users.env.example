# HOMEPOT user seed — TEMPLATE. Copy to scripts/seed-users.env and edit that
# copy instead. scripts/seed-users.env is gitignored; this template is not.
#
#   cp scripts/seed-users.env.example scripts/seed-users.env
#   $EDITOR scripts/seed-users.env
#
# Format: one user per line, username:email:password:role
#   - Blank lines and lines starting with # are ignored.
#   - role accepts Admin or Technician, case-insensitively. Legacy aliases
#     ("admin", "engineer", "viewer", ...) are normalised automatically.
#   - Passwords must be at least 12 characters. Avoid colons and whitespace.
#
# This file holds real credentials. Do not commit it, do not paste it into
# tickets or chat, and rotate any password that does get exposed.
#
# Example — one administrator and one technician:
#
# HOMEPOT_SEED_USERS=(
#   "maziar:maziar@example.com:replace-with-a-long-password:Admin"
#   "techtwo:tech2@example.com:replace-with-another-long-one:Technician"
# )

HOMEPOT_SEED_USERS=(
  "admin:admin@example.com:change-this-before-seeding:Admin"
)

# Optional: point at a remote/split-host database. Prefer passing --url instead
# so the credential and the target stay out of this file.
# HOMEPOT_DB_HOST=51.161.114.195
# HOMEPOT_DB_PORT=5432
