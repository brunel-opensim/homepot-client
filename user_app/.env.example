# HOMEPOT User App Environment Variables
# Copy to .env.local and adjust for your environment. The committed PACKAGED
# build ignores this file: CI supplies VITE_API_BASE_URL to the packaging
# workflow (see .github/workflows/user-app-build.yml). This value only affects
# `npm run electron:dev` / local `npm run build`.
#
# For local development against a backend on this machine:
#   VITE_API_BASE_URL=http://localhost:8000/api/v1

VITE_API_BASE_URL=https://homepot.cabera.com/api/v1
