#!/bin/sh
# homepot-ctl — the only elevated entry point on a Homepot device.
#
# The device agent never receives blanket sudo. Manage ("root_access")
# elevation is scoped to this single root-owned helper, which executes a
# fixed, allowlisted set of host operations as root (restart/shutdown) and the
# owner-authorized free-form `exec` op (script read from stdin, run via the
# shell). Everything else is refused. Nothing is ever executed from argv.
#
# The agent invokes operations via non-interactive sudo:
#     sudo -n /usr/local/homepot/homepot-ctl run restart
#     sudo -n /usr/local/homepot/homepot-ctl run exec < script.sh
# Provisioning / teardown of the sudoers drop-in is done by the same helper:
#     sudo -n /usr/local/homepot/homepot-ctl deprovision
#
# HOMEPOT_ELEVATION_ROOT redirects all paths (used by tests and packaging).
set -eu

if [ -n "${HOMEPOT_ELEVATION_ROOT:-}" ]; then
  BASE="$HOMEPOT_ELEVATION_ROOT"
  SUDOERS_DIR="$BASE/sudoers.d"
  ALLOWLIST="$BASE/allowlist.json"
else
  BASE="/usr/local/homepot"
  SUDOERS_DIR="/etc/sudoers.d"
  ALLOWLIST="/etc/homepot/allowlist.json"
fi

CTL="$BASE/homepot-ctl"
DROPIN="$SUDOERS_DIR/homepot"

usage() {
  echo "usage: $0 {status|ensure-allowlist|run <op>|deprovision}" >&2
  exit 2
}

require_root() {
  if [ "$(id -u)" -ne 0 ]; then
    echo "homepot-ctl: must run as root (elevated entry point)" >&2
    exit 1
  fi
}

cmd_status() {
  installed=no
  [ -f "$CTL" ] && installed=yes
  dropin=no
  [ -f "$DROPIN" ] && dropin=yes
  allowlist=no
  [ -f "$ALLOWLIST" ] && allowlist=yes
  echo "{\"installed\":\"$installed\",\"provisioned\":\"$dropin\",\"allowlist\":\"$allowlist\"}"
}

cmd_run() {
  require_root
  [ "$#" -eq 1 ] || usage
  op="$1"
  # The allowlist is the source of truth (fail-closed): the drop-in scoped sudo
  # to this helper, and the helper itself refuses any op the root-owned
  # allowlist does not list. The agent runs ensure-allowlist on every reconcile
  # while a Manage grant is present, so a missing file only ever fails closed.
  if [ ! -f "$ALLOWLIST" ] || ! grep -q "^op:$op$" "$ALLOWLIST"; then
    echo "homepot-ctl: operation '$op' is not allowed" >&2
    exit 2
  fi
  case "$op" in
    restart)
      if [ -x /sbin/shutdown ]; then exec /sbin/shutdown -r now
      elif [ -x /usr/sbin/shutdown ]; then exec /usr/sbin/shutdown -r now
      else exec shutdown -r now
      fi
      ;;
    shutdown)
      if [ -x /sbin/shutdown ]; then exec /sbin/shutdown -h now
      elif [ -x /usr/sbin/shutdown ]; then exec /usr/sbin/shutdown -h now
      else exec shutdown -h now
      fi
      ;;
    exec)
      # Owner-authorized free-form execution: the script is read from stdin
      # and run through the shell as root. Nothing is taken from argv. The
      # script becomes the process, so stdout/stderr and the exit status flow
      # straight back to the caller.
      exec /bin/sh -s
      ;;
    *)
      echo "homepot-ctl: operation '$op' is not allowlisted" >&2
      exit 2
      ;;
  esac
}

cmd_ensure_allowlist() {
  require_root
  case "$BASE" in
    /etc/*) mkdir -p /etc/homepot ;;
    *) mkdir -p "$(dirname "$ALLOWLIST")" ;;
  esac
  umask 077
  printf '%s\n' "op:restart" "op:shutdown" "op:exec" > "$ALLOWLIST"
  chmod 0600 "$ALLOWLIST"
}

cmd_deprovision() {
  require_root
  rm -f "$DROPIN" "$ALLOWLIST"
}

[ "$#" -ge 1 ] || usage
verb="$1"
shift
case "$verb" in
  status) cmd_status ;;
  ensure-allowlist) cmd_ensure_allowlist ;;
  run) cmd_run "$@" ;;
  deprovision) cmd_deprovision ;;
  *) usage ;;
esac