# HOMEPOT Backend Environment Variables
# Copy this file to .env and update with your values

# Database Configuration
# HOMEPOT now uses PostgreSQL for production-ready architecture
#
# REVERT WHEN PRODUCTION READY (trust -> password).  Under trust the password
# is omitted from the URL (there is no password).  When the server team
# hardens auth, restore the password-embedded default on the line below that
# is currently commented out.  See docs/server-deployment.md -> the one-line
# pg_hba.conf "Revert trust" note.
#
# Trust (dev / demouser passwordless) — ACTIVE. init-postgresql.sh emits this
# under HOMEPOT_DB_AUTH=trust (no password exists, so it is omitted):
DATABASE__URL=postgresql://homepot_user@localhost:5432/homepot_db
#
# Password (hardened production) — REVERT TO THIS when trust is reversed:
# DATABASE__URL=postgresql://homepot_user:homepot_dev_password@localhost:5432/homepot_db

# SQLite is no longer supported — this repo is PostgreSQL-only
# DATABASE__URL=sqlite:///../data/homepot.db

# Database connection pool (see docs/server-deployment.md → "Database
# connection pool"). The async engine now honours these; tune them if you run
# multiple uvicorn workers or see connection-timeout errors.
DATABASE__POOL_SIZE=5
DATABASE__MAX_OVERFLOW=10
DATABASE__POOL_TIMEOUT=30
DATABASE__POOL_RECYCLE=300

# api_request_logs retention (see docs/server-deployment.md → "API request log
# retention"). Rows older than this many days are trimmed by a background task.
# Set to 0 to disable trimming.
DATABASE__API_REQUEST_LOG_RETENTION_DAYS=30

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
ENVIRONMENT=development

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Security
SECRET_KEY=homepot-dev-secret-change-in-production
API_KEY_HEADER=X-API-Key

# Logging
LOG_LEVEL=INFO

# Push Notification Credentials (Optional - use simulation mode if not set)
# FCM (Firebase Cloud Messaging) - Android/Linux
FCM_CREDENTIALS_PATH=

# WNS (Windows Notification Service) - Windows
WNS_PACKAGE_SID=
WNS_CLIENT_SECRET=

# APNs (Apple Push Notification service) - iOS/macOS
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_AUTH_KEY_PATH=

# Web Push (Modern Browsers) - Chrome/Firefox/Safari/Edge
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com

# MQTT Push (IoT/OT Devices) - Sensors/PLCs/Industrial Controllers
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
MQTT_CLIENT_ID=
MQTT_QOS=1
MQTT_RETAIN=false

# WebSocket Settings
WEBSOCKET_PING_INTERVAL=20
WEBSOCKET_PING_TIMEOUT=10

# Agent Simulation
ENABLE_AGENT_SIMULATION=true
